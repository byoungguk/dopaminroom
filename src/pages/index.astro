---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Strengths from '../components/Strengths.astro';
import Steps from '../components/Steps.astro';
import InfoGrid from '../components/InfoGrid.astro';
import PriceTable from '../components/PriceTable.astro';
import PriceCalculator from '../components/PriceCalculator.astro';
import Gallery from '../components/Gallery.astro';
import Rooms from '../components/Rooms.astro';
import LocationMap from '../components/LocationMap.astro';
import Faq from '../components/Faq.astro';
import ContactCard from '../components/ContactCard.astro';
import { VENUE, EVENTS, AMENITIES } from '../venue';
---

<BaseLayout description={`${VENUE.category} ${VENUE.name} · ${VENUE.tagline}`} wide>
  <Hero />

  <div class="container">
    <section class="section" id="about">
      <div class="section-head">
        <h2>소개</h2>
        <p>{VENUE.category} {VENUE.name}</p>
      </div>
      <p class="lead">{VENUE.intro}</p>
    </section>

    <section class="section" id="strength">
      <div class="section-head"><h2>강점</h2></div>
      <Strengths />
    </section>

    <section class="section" id="rooms">
      <div class="section-head">
        <h2>룸 안내</h2>
        <p>인원에 맞는 룸을 안내해 드립니다</p>
      </div>
      <Rooms />
    </section>

    <section class="section" id="amenity">
      <div class="section-head"><h2>시설</h2></div>
      <ul class="chips">
        {AMENITIES.map((item) => <li class="tag">{item}</li>)}
      </ul>
    </section>

    <section class="section" id="process">
      <div class="section-head">
        <h2>이용 절차</h2>
        <p>문의부터 방문까지 4단계</p>
      </div>
      <Steps />
    </section>

    <section class="section" id="hours">
      <div class="section-head">
        <h2>영업시간 · 기본 정보</h2>
        <p>{VENUE.hours} · {VENUE.hoursNote}</p>
      </div>
      <InfoGrid />
    </section>

    <section class="section" id="price">
      <div class="section-head">
        <h2>가격표</h2>
        <p>추가 비용 없는 정찰제</p>
      </div>
      <PriceTable />
    </section>

    <section class="section" id="calc">
      <div class="section-head">
        <h2>비용 계산</h2>
        <p>인원과 시간을 선택하면 예상 금액이 나옵니다</p>
      </div>
      <PriceCalculator />
    </section>

    <section class="section" id="gallery">
      <div class="section-head"><h2>갤러리</h2></div>
      <Gallery />
    </section>

    <section class="section" id="event">
      <div class="section-head"><h2>이벤트 · 특별 서비스</h2></div>
      <div class="events">
        {EVENTS.map((item) => (
          <div class="card">
            <p class="title">{item.title}</p>
            <p class="desc">{item.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="section" id="location">
      <div class="section-head"><h2>오시는 길</h2></div>
      <LocationMap />
    </section>

    <section class="section" id="faq">
      <div class="section-head"><h2>자주 묻는 질문</h2></div>
      <Faq />
    </section>

    <section class="section" id="contact">
      <div class="section-head">
        <h2>예약 및 문의</h2>
        <p>{VENUE.hours} 상시 접수</p>
      </div>
      <ContactCard />
    </section>
  </div>
</BaseLayout>

<style>
  .lead { margin: 0; font-size: 1.02rem; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; margin: 0; padding: 0; }
  .chips li { margin: 0; }
  .events {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 12px;
  }
  .events .title { margin: 0 0 6px; font-weight: 700; color: var(--accent); }
  .events .desc { margin: 0; color: var(--muted); font-size: 0.92rem; }
</style>
