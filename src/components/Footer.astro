---
import { SITE_TITLE } from '../consts';
import { VENUE } from '../venue';
import { withBase } from '../url';

const year = new Date().getFullYear();
---

<footer>
  <div class="container">
    <p class="name">{VENUE.category} {SITE_TITLE}</p>
    <p class="muted">{VENUE.address}</p>
    <p class="muted">예약 문의 {VENUE.phone} · {VENUE.hours}</p>
    <p class="muted warn">본 사이트는 만 19세 이상 성인만 이용할 수 있습니다. 청소년 유해매체물로서 청소년은 이용할 수 없습니다.</p>
    <p class="links">
      <a href={withBase('/blog/')}>공지 · 소식</a>
    </p>
    <p class="muted">© {year} {SITE_TITLE}</p>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    padding: 28px 0 32px;
    background: var(--surface);
  }
  p { margin: 0 0 4px; font-size: 0.88rem; }
  .name { font-weight: 700; font-size: 0.95rem; }
  .warn { margin-top: 10px; }
  .links { margin: 12px 0 8px; }
</style>
