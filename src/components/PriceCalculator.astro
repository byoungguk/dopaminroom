---
import { TIERS, FEES, VENUE } from '../venue';

const config = { tiers: TIERS, fees: FEES };
const tel = VENUE.phone.replace(/-/g, '');
---

<div class="card calc" data-config={JSON.stringify(config)}>
  <div class="fields">
    <label>
      인원
      <select id="calc-people">
        {Array.from({ length: 10 }, (_, i) => i + 1).map((n) => (
          <option value={n} selected={n === 2}>{n}명</option>
        ))}
      </select>
    </label>
    <label>
      이용 시간
      <select id="calc-hours">
        {Array.from({ length: 6 }, (_, i) => i + 1).map((n) => (
          <option value={n} selected={n === 2}>{n}시간</option>
        ))}
      </select>
    </label>
    <label>
      주대 등급
      <select id="calc-tier">
        {TIERS.map((tier) => <option value={tier.id}>{tier.name}</option>)}
      </select>
    </label>
  </div>

  <div class="result">
    <div>
      <span>예상 금액</span>
      <strong id="calc-total">문의</strong>
    </div>
    <p class="breakdown muted" id="calc-breakdown"></p>
  </div>

  <div class="cta">
    <a class="btn" href={`tel:${tel}`}>전화로 확인</a>
    {VENUE.kakao ? (
      <a class="btn ghost" href={VENUE.kakao} target="_blank" rel="noopener">카톡 문의</a>
    ) : (
      <a class="btn ghost" href={`sms:${tel}?body=${encodeURIComponent(VENUE.smsTemplate)}`}>문자 문의</a>
    )}
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('.calc');
  if (root) {
    const { tiers, fees } = JSON.parse(root.dataset.config ?? '{}');
    const pick = (id: string) => document.getElementById(id) as HTMLSelectElement | null;
    const totalEl = document.getElementById('calc-total');
    const breakdown = document.getElementById('calc-breakdown');
    const won = (n: number) => `${Math.round(n).toLocaleString('ko-KR')}원`;

    const update = () => {
      if (!totalEl || !breakdown) return;
      const people = Number(pick('calc-people')?.value) || 0;
      const hours = Number(pick('calc-hours')?.value) || 0;
      const tier = tiers.find((t: any) => t.id === pick('calc-tier')?.value);

      const tc = people * hours * (fees.tcPerHour || 0);
      const bottle = tier?.price || 0;
      const rt = fees.rt || 0;
      const total = tc + bottle + rt;

      // 단가가 아직 입력되지 않았으면 계산하지 않는다
      if (total <= 0) {
        totalEl.textContent = '문의';
        breakdown.textContent = '가격이 확정되면 예상 금액이 표시됩니다.';
        return;
      }

      // 참고 사이트와 동일하게 부가세 별도 기준 합계만 표시
      totalEl.textContent = won(total);
      breakdown.textContent = [
        `주대 ${won(bottle)}`,
        `TC ${won(tc)}`,
        rt > 0 ? `RT ${won(rt)}` : '',
        '부가세 별도',
      ]
        .filter(Boolean)
        .join(' · ');
    };

    ['calc-people', 'calc-hours', 'calc-tier'].forEach((id) =>
      pick(id)?.addEventListener('change', update)
    );
    update();
  }
</script>

<style>
  .fields {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 12px;
  }
  label { display: flex; flex-direction: column; gap: 6px; font-size: 0.85rem; color: var(--muted); }
  select {
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 11px 12px;
    color: var(--text);
    font-size: 1rem;
    font-family: inherit;
  }
  select:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
  .result {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }
  .result > div { display: flex; align-items: baseline; justify-content: space-between; }
  .result span { color: var(--muted); font-size: 0.9rem; }
  .result strong { font-size: 1.6rem; color: var(--accent); }
  .breakdown { margin: 8px 0 0; font-size: 0.82rem; }
  .cta { display: flex; gap: 8px; margin-top: 16px; }
  .cta .btn { flex: 1; padding: 11px 14px; font-size: 0.95rem; }
</style>
