---
import { PHOTOS } from '../venue';
import { withBase } from '../url';
---

{PHOTOS.length > 0 ? (
  <div class="grid">
    {PHOTOS.map((photo) => (
      <figure>
        <img src={withBase(`/${photo.src}`)} alt={photo.alt} loading="lazy" />
      </figure>
    ))}
  </div>
) : (
  <div class="card empty"><p>사진 준비 중입니다.</p></div>
)}

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 10px;
  }
  figure { margin: 0; }
  figure img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border: 1px solid var(--border);
  }
  .empty { text-align: center; }
  .empty p { margin: 0; }
</style>
