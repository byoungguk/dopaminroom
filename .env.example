# 복사해서 .env 로 쓴다:  cp .env.example .env
# .env 는 git 에 올리지 않는다 (비밀번호 포함)

# 사이트 주소. 도메인 연결 전에는 서버 IP 를 넣는다.
#   예) http://13.125.0.1/   →  https://dopaminroom.kr/
BASE_URL=https://dopaminroom.kr/

# 인증서 발급용 도메인 (www 없이)
DOMAIN=dopaminroom.kr
# 대표 주소에 www 를 쓸지 (1=www.dopaminroom.kr, 0=dopaminroom.kr)
USE_WWW=0
# 인증서 만료 알림 메일. 비워두면 알림 없이 발급한다.
EMAIL=

# 공개 포트
HTTP_PORT=80
HTTPS_PORT=443

# 관리자 로그인 (고객에게 전달하는 계정)
ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_ME
# 로그인 세션 암호화 키. 아래 명령으로 만들어 넣는다.
#   openssl rand -hex 32
ADMIN_SECRET_KEY=CHANGE_ME

TZ=Asia/Seoul
