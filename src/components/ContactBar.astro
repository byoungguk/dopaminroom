---
import { VENUE } from '../venue';
---

<div class="bar">
  <a class="call" href={`tel:${VENUE.phone.replace(/-/g, '')}`}>📞 전화 예약</a>
  <a class="kakao" href={VENUE.kakao} target="_blank" rel="noopener">💬 카톡 문의</a>
</div>

<style>
  .bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 20;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--border);
    border-top: 1px solid var(--border);
  }
  .bar a {
    padding: 16px 8px;
    text-align: center;
    font-weight: 700;
    font-size: 0.98rem;
  }
  .bar a:hover { text-decoration: none; }
  .call { background: var(--accent); color: #1a1206; }
  .kakao { background: var(--surface); color: var(--text); }
</style>
