---
import BaseLayout from '../layouts/BaseLayout.astro';
import { VENUE } from '../venue';
---

<BaseLayout title="소개" description={`${VENUE.name} 소개`}>
  <h1>{VENUE.name} 소개</h1>
  <div class="prose">
    <p>{VENUE.tagline}</p>
    <p class="muted">※ 소개 문구는 고객 확인 후 교체 예정입니다.</p>
  </div>
</BaseLayout>
