---
import { VENUE } from '../venue';

const tel = VENUE.phone.replace(/-/g, '');
---

<div class="card contact">
  <p class="phone"><a href={`tel:${tel}`}>{VENUE.phone}</a></p>
  <p class="muted">담당 {VENUE.manager} · 부재 시 회신드립니다</p>
  <div class="cta">
    <a class="btn" href={`tel:${tel}`}>전화 예약</a>
    {VENUE.kakao && (
      <a class="btn ghost" href={VENUE.kakao} target="_blank" rel="noopener">카카오톡</a>
    )}
    <a class="btn ghost" href={`sms:${tel}?body=${encodeURIComponent(VENUE.smsTemplate)}`}>문자 예약</a>
  </div>
</div>

<style>
  .contact { text-align: center; }
  .phone { margin: 0 0 4px; font-size: 1.8rem; font-weight: 800; letter-spacing: -0.02em; }
  .phone a { color: var(--accent); }
  .cta { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; margin-top: 16px; }
</style>
