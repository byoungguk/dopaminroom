---
import { VENUE } from '../venue';

const tel = VENUE.phone.replace(/-/g, '');
const sms = `sms:${tel}?body=${encodeURIComponent(VENUE.smsTemplate)}`;

// 카카오 링크를 아직 못 받았으면 전화·문자 2개만 노출
const items = [
  { href: `tel:${tel}`, label: '📞 전화', cls: 'call', external: false },
  ...(VENUE.kakao ? [{ href: VENUE.kakao, label: '💬 카톡', cls: 'sub', external: true }] : []),
  { href: sms, label: '✉️ 문자', cls: 'sub', external: false },
];
---

<div class="bar" style={`grid-template-columns: repeat(${items.length}, 1fr)`}>
  {items.map((item) => (
    <a
      class={item.cls}
      href={item.href}
      target={item.external ? '_blank' : undefined}
      rel={item.external ? 'noopener' : undefined}
    >
      {item.label}
    </a>
  ))}
</div>

<style>
  .bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 20;
    display: grid;
    gap: 1px;
    background: var(--border);
    border-top: 1px solid var(--border);
  }
  .bar a {
    padding: 15px 6px;
    text-align: center;
    font-weight: 700;
    font-size: 0.95rem;
  }
  .bar a:hover { text-decoration: none; }
  .call { background: var(--accent); color: #04101f; }
  .sub { background: var(--surface); color: var(--text); }
</style>
