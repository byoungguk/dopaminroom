---
import { VENUE } from '../venue';

const format = (n: number) => (n > 0 ? `${n.toLocaleString('ko-KR')}원` : '문의');
---

<table>
  <thead>
    <tr><th>항목</th><th class="num">금액</th></tr>
  </thead>
  <tbody>
    {VENUE.prices.map((row) => (
      <tr>
        <td>{row.item}{row.note && <span class="muted"> · {row.note}</span>}</td>
        <td class="num">{format(row.price)}</td>
      </tr>
    ))}
  </tbody>
</table>
<p class="muted note">{VENUE.priceNote}</p>

<style>
  .note { margin: 12px 0 0; }
</style>
