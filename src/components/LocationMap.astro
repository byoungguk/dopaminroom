---
import { VENUE } from '../venue';

const query = encodeURIComponent(VENUE.mapQuery);
const embed = `https://maps.google.com/maps?q=${query}&output=embed`;
const naver = `https://map.naver.com/p/search/${query}`;
---

<div class="card">
  <p class="addr">{VENUE.address}</p>
  <ul class="access">
    {VENUE.access.map((line) => <li>{line}</li>)}
  </ul>
  <div class="map" data-embed={embed}>
    <button type="button" class="btn ghost load-map">지도 보기</button>
  </div>
  <p><a href={naver} target="_blank" rel="noopener">네이버 지도에서 열기 →</a></p>
</div>

<script>
  // 지도는 클릭할 때만 불러온다 (첫 로딩 속도)
  document.querySelectorAll<HTMLElement>('.map').forEach((box) => {
    box.querySelector('.load-map')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = box.dataset.embed ?? '';
      iframe.loading = 'lazy';
      iframe.title = '약도';
      iframe.referrerPolicy = 'no-referrer-when-downgrade';
      box.replaceChildren(iframe);
    });
  });
</script>

<style>
  .addr { margin: 0 0 8px; font-weight: 700; font-size: 1.05rem; }
  .access { margin: 0 0 14px; padding-left: 18px; color: var(--muted); font-size: 0.92rem; }
  .map {
    display: grid;
    place-items: center;
    min-height: 200px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .map :global(iframe) { width: 100%; height: 320px; border: 0; display: block; }
  .card > p:last-child { margin-bottom: 0; }
</style>
