---
import { VENUE } from '../venue';
import { withBase } from '../url';

const tel = VENUE.phone.replace(/-/g, '');
const bg = withBase('/images/dopamin-entrance.png');
---

<section class="hero" style={`--hero-bg: url('${bg}')`}>
  <div class="container">
    <p class="eyebrow">{VENUE.category}</p>
    <h1>{VENUE.name}</h1>
    <p class="tagline">{VENUE.tagline}</p>
    <ul class="quick">
      <li>{VENUE.hours} 운영</li>
      <li>선릉역 도보 3분</li>
      <li>정찰제</li>
    </ul>
    <div class="actions">
      <a class="btn" href={`tel:${tel}`}>전화 예약</a>
      {VENUE.kakao && (
        <a class="btn ghost" href={VENUE.kakao} target="_blank" rel="noopener">카카오톡</a>
      )}
      <a class="btn ghost" href={`sms:${tel}?body=${encodeURIComponent(VENUE.smsTemplate)}`}>문자 예약</a>
    </div>
    <p class="notice">만 19세 이상 성인만 이용할 수 있습니다.</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 96px 0 64px;
    text-align: center;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--hero-bg);
    background-size: cover;
    background-position: center;
    opacity: 0.45;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(7, 9, 15, 0.55) 0%, rgba(7, 9, 15, 0.82) 55%, var(--bg) 100%);
  }
  .hero .container { position: relative; z-index: 1; }
  .eyebrow {
    margin: 0 0 8px;
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }
  h1 {
    margin: 0 0 10px;
    font-size: clamp(2.6rem, 10vw, 3.8rem);
    text-shadow: 0 0 22px var(--accent-glow);
  }
  .tagline { margin: 0 0 18px; color: #d7e2f5; font-size: 1.05rem; }
  .quick {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 18px;
    margin: 0 0 26px;
    padding: 0;
    list-style: none;
    color: var(--muted);
    font-size: 0.88rem;
  }
  .quick li { position: relative; }
  .quick li + li::before {
    content: '';
    position: absolute;
    left: -10px;
    top: 50%;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--border);
  }
  .actions { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; }
  .notice { margin: 20px 0 0; font-size: 0.82rem; color: var(--muted); }
</style>
