---
import { VENUE } from '../venue';

const rows = [
  { label: '영업시간', value: `${VENUE.hours} · ${VENUE.hoursNote}` },
  { label: '위치', value: VENUE.access[0] },
  { label: '룸', value: '1인 ~ 10인 이상 (룸 타입별)' },
  { label: '주차', value: 'VIP 픽업 · 발렛 문의' },
  { label: '예약', value: '전화 · 문자 상시 접수' },
  { label: '이용 안내', value: '만 19세 이상 성인 전용' },
];
---

<div class="grid">
  {rows.map((row) => (
    <div class="card">
      <p class="label">{row.label}</p>
      <p class="value">{row.value}</p>
    </div>
  ))}
</div>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 12px;
  }
  .label { margin: 0 0 4px; color: var(--muted); font-size: 0.85rem; }
  .value { margin: 0; font-weight: 600; }
</style>
