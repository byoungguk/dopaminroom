---
import { VENUE } from '../venue';

const tel = VENUE.phone.replace(/-/g, '');
---

<div class="bar">
  <a class="call" href={`tel:${tel}`}>📞 전화</a>
  <a class="kakao" href={VENUE.kakao} target="_blank" rel="noopener">💬 카톡</a>
  <a class="sms" href={`sms:${tel}?body=${encodeURIComponent(VENUE.smsTemplate)}`}>✉️ 문자</a>
</div>

<style>
  .bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 20;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--border);
    border-top: 1px solid var(--border);
  }
  .bar a {
    padding: 15px 6px;
    text-align: center;
    font-weight: 700;
    font-size: 0.95rem;
  }
  .bar a:hover { text-decoration: none; }
  .call { background: var(--accent); color: #1a1206; }
  .kakao, .sms { background: var(--surface); color: var(--text); }
</style>
