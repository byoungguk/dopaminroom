---
import { VENUE } from '../venue';

const tel = VENUE.phone.replace(/-/g, '');
---

<section class="hero">
  <div class="container">
    <p class="eyebrow">{VENUE.category}</p>
    <h1>{VENUE.name}</h1>
    <p class="tagline">{VENUE.tagline}</p>
    <ul class="quick">
      <li>{VENUE.hours}</li>
      <li>{VENUE.scale}</li>
      <li>상시 {VENUE.staffCount}</li>
    </ul>
    <div class="actions">
      <a class="btn" href={`tel:${tel}`}>전화 예약</a>
      <a class="btn ghost" href={VENUE.kakao} target="_blank" rel="noopener">카카오톡</a>
      <a class="btn ghost" href={`sms:${tel}?body=${encodeURIComponent(VENUE.smsTemplate)}`}>문자 예약</a>
    </div>
    <p class="notice">만 19세 이상 성인만 이용할 수 있습니다.</p>
  </div>
</section>

<style>
  .hero {
    padding: 76px 0 56px;
    background:
      radial-gradient(120% 80% at 50% 0%, rgba(217, 164, 65, 0.18), transparent 62%),
      var(--bg);
    text-align: center;
  }
  .eyebrow {
    margin: 0 0 8px;
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }
  h1 { margin: 0 0 10px; font-size: clamp(2.4rem, 9vw, 3.4rem); }
  .tagline { margin: 0 0 18px; color: var(--muted); font-size: 1.05rem; }
  .quick {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 18px;
    margin: 0 0 26px;
    padding: 0;
    list-style: none;
    color: var(--muted);
    font-size: 0.88rem;
  }
  .quick li { position: relative; }
  .quick li + li::before {
    content: '';
    position: absolute;
    left: -10px;
    top: 50%;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--border);
  }
  .actions { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; }
  .notice { margin: 20px 0 0; font-size: 0.82rem; color: var(--muted); }
</style>
